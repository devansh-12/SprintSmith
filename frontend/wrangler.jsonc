{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprintsmith-frontend",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "app.rajmathuria.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}